# Django Configuration
DJANGO_SECRET_KEY=marketplace-super-secret-key-change-in-production-$(date +%s)
DEBUG=False
ALLOWED_HOSTS=*.onion,localhost,127.0.0.1,django,172.18.0.6,openresty

# Database Configuration
DATABASE_URL=postgresql://marketplace:marketplace_password@db:5432/marketplace

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Cryptocurrency RPC Configuration
BITCOIND_RPC_URL=http://127.0.0.1:8332
BITCOIND_RPC_USER=bitcoin_user
BITCOIND_RPC_PASSWORD=bitcoin_password
MONERO_WALLET_RPC_PORT=18088
MONERO_DAEMON_RPC_PORT=18081

# Security Configuration
ENCRYPTION_KEY=marketplace-encryption-key-32-chars-long
ADMIN_EMAIL=admin@marketplace.local

# Additional Environment Variables
TOTP_ENCRYPTION_KEY=totp-encryption-key-for-2fa-secrets
