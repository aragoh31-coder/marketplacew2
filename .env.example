# Django Core
DJANGO_SECRET_KEY=your_super_secret_key_here
DEBUG=True
ALLOWED_HOSTS=.onion,127.0.0.1,localhost

# Database
DB_NAME=marketplace
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_SECONDARY_PASSWORD=your_secure_secondary_password_here

# Cryptocurrency Daemons
BITCOIND_RPC_URL=http://127.0.0.1:8332
BITCOIND_RPC_USER=your_rpc_user
BITCOIND_RPC_PASSWORD=your_rpc_password
MONERO_WALLET_RPC_PORT=18088
MONERO_DAEMON_RPC_PORT=18081

# Security / Encryption
ENCRYPTION_KEY=your_fernet_encryption_key_here
