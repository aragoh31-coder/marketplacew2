# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=.onion,localhost,127.0.0.1,django,openresty
# Optional exact onion host (e.g., 677ocptjrtgais5duw3ilnpiehyalubowul42g24s4p4hwy3ed5xchqd.onion)
ONION_HOST=

# HMAC key for OpenResty edge (set to a long random value in your real .env, not committed)
HMAC_KEY=
# Request signature secret (defaults to DJANGO_SECRET_KEY if unset)
REQUEST_SIG_SECRET=
# Allow insecure cookies over onion HTTP (for Tor). Set to 1 to disable Secure flag on session/csrf cookies.
ALLOW_INSECURE_ONION_COOKIES=1


# Security Keys (generate secure values for production)
FIELD_ENCRYPTION_KEY=your-field-encryption-key-here
TOTP_ENCRYPTION_KEY=your-totp-encryption-key-here
CIRCUIT_FINGERPRINT_SECRET=your-circuit-fingerprint-secret-here

# Admin Security
ADMIN_SECONDARY_PASSWORD=your-admin-secondary-password-here
ADMIN_SECONDARY_PASSWORD_HASH=sha256-hash-of-your-admin-password
ADMIN_EMAIL=admin@marketplace.local

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/marketplace

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Cryptocurrency
BITCOIND_RPC_URL=http://127.0.0.1:8332
BITCOIND_RPC_USER=your-bitcoin-rpc-user
BITCOIND_RPC_PASSWORD=your-bitcoin-rpc-password
MONERO_WALLET_RPC_PORT=18088
MONERO_DAEMON_RPC_PORT=18081
