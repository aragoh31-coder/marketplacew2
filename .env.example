# Database Configuration
DB_NAME=marketplace
DB_USER=marketplace_user
DB_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# Django Configuration
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Email Configuration
ADMIN_EMAIL=admin@yourdomain.com

# Security Configuration
MASTER_PASSWORD=your_master_password_here
MASTER_SALT=your_master_salt_here
ADMIN_SECONDARY_PASSWORD=your_secondary_password_here

# Cryptocurrency Configuration (if using)
BITCOIND_RPC_URL=http://localhost:8332
BITCOIND_RPC_USER=bitcoinrpc
BITCOIND_RPC_PASSWORD=your_bitcoin_rpc_password
MONERO_WALLET_RPC_PORT=18082
MONERO_DAEMON_RPC_PORT=18081