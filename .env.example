# === DATABASE (Least Privilege) ===
DATABASE_URL=postgres://app_user:AUTOGEN@postgres:5432/marketplace?sslmode=require
DATABASE_MIGRATE_URL=postgres://migrator:AUTOGEN@postgres:5432/marketplace?sslmode=require
DATABASE_READONLY_URL=postgres://readonly:AUTOGEN@postgres:5432/marketplace?sslmode=require

# === REDIS ===
REDIS_URL=redis://:AUTOGEN@redis:6379/0
REDIS_CACHE_TTL=3600

# === SECURITY KEYS (Auto-generated) ===
MASTER_KEY=AUTOGEN_64B_BASE64
COOKIE_KEY=AUTOGEN_32B_BASE64
CSRF_KEY=AUTOGEN_32B_BASE64
GIFT_ENCRYPTION_KEY=AUTOGEN_32B_BASE64

# === ARGON2 (Hardened) ===
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=4
ARGON2_PARALLELISM=2

# === TOR ===
ONION_ADDRESS=AUTOGEN.onion
FORCE_TOR=true

# === CRYPTO PAYMENTS ===
BTC_RPC=http://bitcoin:8332
BTC_RPC_USER=AUTOGEN
BTC_RPC_PASS=AUTOGEN
XMR_RPC=http://monero:18082/json_rpc
ESCROW_TIMEOUT_HOURS=24
AUTO_RELEASE=true

# === RATE LIMITING ===
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
POW_DIFFICULTY=20

# === FEATURES ===
ENABLE_SEARCH=true
ENABLE_RECOMMENDATIONS=true
ENABLE_2FA=true
REQUIRE_2FA_ADMIN=true

# === MONITORING ===
METRICS_ENABLED=true
LOG_LEVEL=info
SENTRY_DSN=optional
