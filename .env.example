# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=.onion,localhost,127.0.0.1

# Security Keys (generate secure values for production)
FIELD_ENCRYPTION_KEY=your-field-encryption-key-here
TOTP_ENCRYPTION_KEY=your-totp-encryption-key-here
CIRCUIT_FINGERPRINT_SECRET=your-circuit-fingerprint-secret-here

# Admin Security
ADMIN_SECONDARY_PASSWORD=your-admin-secondary-password-here
ADMIN_SECONDARY_PASSWORD_HASH=sha256-hash-of-your-admin-password

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/marketplace

# Cryptocurrency
BITCOIND_RPC_USER=your-bitcoin-rpc-user
BITCOIND_RPC_PASSWORD=your-bitcoin-rpc-password
