{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Purple Market{% endblock %}</title>
  <!-- Single CSS file reference -->
  <link rel="stylesheet" href="{% static 'css/theme.css' %}">
  {% block extra_head %}{% endblock %}
</head>
<body>
  <header>
    <nav class="navbar">
      <div class="container">
        <a class="brand" href="{% url 'accounts:home' %}">Purple Market</a>
        <ul class="nav-links">
          <li><a href="{% url 'accounts:home' %}">Home</a></li>
          <li><a href="{% url 'products:list' %}">Products</a></li>
          <li><a href="{% url 'vendors:list' %}">Vendors</a></li>
          <li><a href="{% url 'orders:cart' %}">Cart</a></li>
          <li><a href="{% url 'messaging:list' %}">Messages</a></li>
        </ul>
        <ul class="user-links">
          {% if user.is_authenticated %}
            <li><a href="{% url 'accounts:profile_settings' %}">Settings</a></li>
            <li><a href="{% url 'logout' %}">Logout</a></li>
          {% else %}
            <li><a href="{% url 'accounts:login' %}">Login</a></li>
            <li><a href="{% url 'accounts:register' %}">Register</a></li>
          {% endif %}
        </ul>
      </div>
    </nav>
  </header>
  <main class="content container">
    {% block content %}{% endblock %}
  </main>
  <footer class="footer">
    <div class="container">
      &copy; {{ now|date:"Y" }} Purple Market. All rights reserved.
      <br>
      <small>Accessed via Tor: {% if request.META.HTTP_X_FORWARDED_FOR %}Yes{% else %}No{% endif %}</small>
    </div>
  </footer>
</body>
</html>
